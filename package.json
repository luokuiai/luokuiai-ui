{
  "name": "@luokui/ui",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "The React components, styles and assets from LUOKUI-AI.",
  "license": "UNLICENSED",
  "files": ["dist/workspace.css", "dist/files", "dist/integrations", "workspace-ui", "scripts/copy-assets.mjs"],
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": "./workspace-ui/index.ts",
    "./components/*": "./workspace-ui/components/*",
    "./utils/*": "./workspace-ui/utils/*",
    "./assets/*": "./workspace-ui/public/*",
    "./styles.css": "./dist/workspace.css",
    "./workspace.css": "./dist/workspace.css",
    "./analytics": "./workspace-ui/lib/analytics.ts",
    "./chat": { "types": "./dist/integrations/chat.d.ts", "default": "./dist/integrations/chat.js" },
    "./chat-bisheng.css": "./dist/integrations/chat-bisheng.css",
    "./activity-heatmap": { "types": "./dist/integrations/activity-heatmap.d.ts", "default": "./dist/integrations/activity-heatmap.js" },
    "./activity-heatmap.css": "./dist/integrations/activity-heatmap.css",
    "./dashboard": { "types": "./dist/integrations/dashboard.d.ts", "default": "./dist/integrations/dashboard.js" },
    "./icons": { "types": "./dist/integrations/icons.d.ts", "default": "./dist/integrations/icons.js" },
    "./presentation": { "types": "./dist/integrations/presentation.d.ts", "default": "./dist/integrations/presentation.js" },
    "./package.json": "./package.json"
  },
  "bin": { "luokui-ui-assets": "./scripts/copy-assets.mjs" },
  "repository": { "type": "git", "url": "git+https://github.com/luokuiai/luokuiai-ui.git" },
  "engines": { "node": ">=22" },
  "workspaces": ["demo"],
  "scripts": {
    "build": "tsc -p tsconfig.integrations.json && node scripts/build-styles.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.workspace.json",
    "typecheck:workspace": "npm run typecheck",
    "test": "npm run build && npm run typecheck && node --test test/*.test.mjs",
    "demo": "npm run dev --workspace luokui-ui-demo",
    "demo:build": "npm run build --workspace luokui-ui-demo"
  },
  "peerDependencies": {
    "next": "^16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": { "next": { "optional": true } },
  "dependencies": {
    "@ai-sdk/react": "^4.0.90",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.6",
    "@internationalized/date": "^3.12.1",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^7.0.87",
    "motion": "^12.42.2",
    "prism-react-renderer": "^2.4.1",
    "react-aria-components": "^1.17.0",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
