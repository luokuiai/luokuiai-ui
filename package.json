{
  "name": "@luokui/ui",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Reusable React components for LUOKUI projects.",
  "license": "UNLICENSED",
  "files": ["dist", "workspace-ui"],
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": "./dist/index.js",
    "./chat": "./dist/chat.js",
    "./chat.css": "./dist/chat.css",
    "./chat-workbench.css": "./dist/chat-workbench.css",
    "./chat-bisheng.css": "./dist/chat-bisheng.css",
    "./dashboard": "./dist/dashboard.js",
    "./dashboard.css": "./dist/dashboard.css",
    "./activity-heatmap": "./dist/activity-heatmap.js",
    "./activity-heatmap.css": "./dist/activity-heatmap.css",
    "./presentation": "./dist/presentation.js",
    "./list-section": "./dist/list-section.js",
    "./icons": "./dist/icons.js",
    "./styles.css": "./dist/styles.css",
    "./workspace.css": "./dist/workspace.css",
    "./components/*": "./workspace-ui/components/*",
    "./assets/*": "./workspace-ui/public/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luokuiai/luokuiai-ui.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-styles.mjs && tailwindcss -i workspace-ui/styles/package.css -o dist/workspace.css --minify",
    "typecheck:workspace": "tsc -p tsconfig.workspace.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test",
    "preview": "node scripts/preview.mjs",
    "sync:desktop": "npm run build && node scripts/sync-desktop.mjs"
  },
  "peerDependencies": {
    "next": "^16.4.6",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": { "optional": true }
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.90",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@internationalized/date": "^3.12.1",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^7.0.87",
    "motion": "^12.42.2",
    "prism-react-renderer": "^2.4.1",
    "react-aria-components": "^1.17.0",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.25.12",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
